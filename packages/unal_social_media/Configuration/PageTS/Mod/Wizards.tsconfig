mod {
  wizards.newContentElement.wizardItems.plugins {
    elements {
      filter {
        iconIdentifier = unal_social_media-plugin-filter
        title = LLL:EXT:unal_social_media/Resources/Private/Language/locallang_db.xlf:tx_unal_social_media_filter.name
        description = LLL:EXT:unal_social_media/Resources/Private/Language/locallang_db.xlf:tx_unal_social_media_filter.description
        tt_content_defValues {
          CType = list
          list_type = unalsocialmedia_filter
        }
      }

      list {
        iconIdentifier = unal_social_media-plugin-list
        title = LLL:EXT:unal_social_media/Resources/Private/Language/locallang_db.xlf:tx_unal_social_media_list.name
        description = LLL:EXT:unal_social_media/Resources/Private/Language/locallang_db.xlf:tx_unal_social_media_list.description
        tt_content_defValues {
          CType = list
          list_type = unalsocialmedia_list
        }
      }
    }

    show = *
  }
}