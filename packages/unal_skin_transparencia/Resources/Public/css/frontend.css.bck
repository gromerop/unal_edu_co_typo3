@import url('https://fonts.googleapis.com/css?family=Quicksand:300,400,500,600,700&display=swap');
body {background:white;}
#transparencia-encabezado {background:#f5f5f5; font-family: 'Catamaran', sans-serif; margin-bottom:30px;} 
#transparencia-encabezado h1 {font-family: 'Quicksand', sans-serif; font-weight:900; padding:5vw 0 1vw 0vw;color:#55d3fa;}
#transparencia-encabezado p {font-family: 'Quicksand', sans-serif;  padding:0 20vw 1vw 5vw;font-weight:600;}
.transparencia-contenido .col-md-4 .csc-default {background:#f5f5f5; height:750px;overflow:auto;}
#c1019 {height:auto;}
#c1006 {height:auto;}

.transparencia-contenido .col-md-4 .csc-default h1 {font-family: 'Quicksand', sans-serif; font-weight:900; padding:3vw 6vw;color:#fff;background-image: url('http://35.153.234.9/fileadmin/transparencia/b2e31420.png');font-size:2em;}
.transparencia-contenido .col-md-4 .csc-default h2 {font-family: 'Quicksand', sans-serif; font-weight:900; padding:3vw 6vw;color:#fff;background-image: url('http://35.153.234.9/fileadmin/transparencia/b2e31420.png');font-size:2em;}
.transparencia-contenido .col-md-4 .csc-default h3 {font-family: 'Quicksand', sans-serif; font-weight:900; padding:0 0 1vw 0;color:#55d3fa;font-size:2em;}
.transparencia-contenido .col-md-4 .csc-default .csc-textpic-text {padding:20px;}

@media (max-width: 1170px) {
  .transparencia-contenido .col-md-4 .csc-default h1 {font-size:1.6em; }
  }

@media (max-width: 992px) {
  .transparencia-contenido .col-md-4 .csc-default h1 {padding:0 0 50px 3vw; }
  .transparencia-contenido .col-md-4 .csc-default {height:auto;}
.csc-textpic-intext-left-nowrap .csc-textpic-text {margin-left:25px; margin-bottom:20px;}
  }


.transparencia-contenido {padding:30px;}
.transparencia-contenido p {font-family: 'Quicksand', sans-serif;  font-weight:600; line-height:1.3em;}
.transparencia-contenido p a {font-size:1.2em;text-decoration:underline; color:#32758a;font-weight:900; margin-bottom:5px; }
.csc-textpic {background:#f5f5f5;}
.csc-textpic-imagewrap {padding:5vw 5vw 2vw 10vw;}
.panel-default > .panel-heading {font-family: 'Quicksand', sans-serif; font-weight: 900; padding: 1vw; color:#fff;font-family: 'Quicksand', sans-serif; font-weight: 900; padding: 1vw; color:#fff; background-image: url('http://35.153.234.9/fileadmin/transparencia/b2e31420.png'); font-size: 1.5em;  }
.panel-default > .panel-heading h4 {font-family: 'Quicksand', sans-serif; font-weight: 900; color:#fff;}
.csc-uploads-fileName a {font-size: 1.2em; text-decoration: underline;color:#32758a;font-weight: 900;margin-bottom: 5px; }
.panel-default > .panel-heading + .panel-collapse .panel-body {background-color:#f5f5f5;}
