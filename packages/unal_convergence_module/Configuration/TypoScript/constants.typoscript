plugin.tx_unalconvergencemodule {
    settings{
    }
    view {
        # cat=plugin.tx_unalconvergencemodule/file; type=string; label=Path to template root (FE)
        templateRootPath = EXT:unal_convergence_module/Resources/Private/Templates/
        # cat=plugin.tx_unalconvergencemodule/file; type=string; label=Path to template partials (FE)
        partialRootPath = EXT:unal_convergence_module/Resources/Private/Partials/
        # cat=plugin.tx_unalconvergencemodule/file; type=string; label=Path to template layouts (FE)
        layoutRootPath = EXT:unal_convergence_module/Resources/Private/Layouts/
    }
    persistence {
        # cat=plugin.tx_unalconvergencemodule//a; type=string; label=Default storage PID
        storagePid =
        #recursive  = 1
    }
}

module.tx_unalconvergencemodule {
    view {
        # cat=module.tx_unalconvergencemodule/file; type=string; label=Path to template root (FE)
        templateRootPath = EXT:unal_convergence_module/Resources/Private/Backend/Templates/
        # cat=module.tx_unalconvergencemodule/file; type=string; label=Path to template partials (FE)
        partialRootPath = EXT:unal_convergence_module/Resources/Private/Backend/Partials/
        # cat=module.tx_unalconvergencemodule/file; type=string; label=Path to template layouts (FE)
        layoutRootPath = EXT:unal_convergence_module/Resources/Private/Backend/Layouts/
    }
}