<T3DataStructure>
   <meta>
      <langDisable>1</langDisable>
   </meta>
   <sheets>
      
    <general>
        <ROOT>
            <TCEforms>
                <sheetTitle>LLL:EXT:extkey/Resources/Private/Language/Backend.xlf:settings.registration.title</sheetTitle>
            </TCEforms>
            <type>array</type>
            <el>
                <!-- Add settings here ... -->

                <switchableControllerActions>
                    <TCEforms>
                        <label>LLL:EXT:unal_convergence_module/Resources/Private/Language/locallang_db.xlf:flex_content.view</label>
                        <onChange>reload</onChange>
                        <config>
                            <type>select</type>
                            <eval>required</eval>
                            <renderType>selectSingle</renderType>
                            <size>1</size>
                            <maxitems>1</maxitems>
                            <items type="array">
                                <numIndex index="0" type="array">
                                    <numIndex index="0"></numIndex>
                                    <numIndex index="1"></numIndex>
                                </numIndex>
                                <numIndex index="1" type="array">
                                    <numIndex index="0">LLL:EXT:unal_convergence_module/Resources/Private/Language/locallang_db.xlf:flex_content.slider</numIndex>
                                    <numIndex index="1">Content->slider</numIndex>
                                </numIndex>
                                <numIndex index="2" type="array">
                                    <numIndex index="0">LLL:EXT:unal_convergence_module/Resources/Private/Language/locallang_db.xlf:flex_content.vertical</numIndex>
                                    <numIndex index="1">Content->vertical</numIndex>
                                </numIndex>
                                <numIndex index="3" type="array">
                                    <numIndex index="0">LLL:EXT:unal_convergence_module/Resources/Private/Language/locallang_db.xlf:flex_content.template</numIndex>
                                    <numIndex index="1">Content->template</numIndex>
                                </numIndex>
                            </items>
                        </config>
                    </TCEforms>
                </switchableControllerActions>

                <!-- settings.layout -->
                <settings.layout>
                    <TCEforms>
                        <label>Plantilla</label>
                        <displayCond>FIELD:general.switchableControllerActions:=:Content->template</displayCond>
                        <config>
                            <type>select</type>
                            <itemsProcFunc>UNAL\UnalConvergenceModule\Backend\ItemsProcFuncs\ItemsProcFunc->customTemplatesList</itemsProcFunc>
                            <renderType>selectSingle</renderType>
                            <items>
                                <!-- empty by default -->
                            </items>
                        </config>
                    </TCEforms>
                </settings.layout>
                <!-- end of settings -->
                
                <!-- settings.layout -->
                <settings.contenido>
                    <TCEforms>
                        <label>Contenido</label>
                        <displayCond>
                            <or>
                                <value1>FIELD:switchableControllerActions:=:Content->slider</value1>
                                <value2>FIELD:switchableControllerActions:=:Content->vertical</value2>
                            </or>
                        </displayCond>
                        <config>
                            <type>select</type>
                            <itemsProcFunc>UNAL\UnalConvergenceModule\Backend\ItemsProcFuncs\ItemsProcFunc->contentList</itemsProcFunc>
                            <renderType>selectMultipleSideBySide</renderType>
                            <items>
                                <!-- empty by default -->
                            </items>
                        </config>
                    </TCEforms>
                </settings.contenido>
                <!-- end of settings -->

                <settings.slider.dots>
                    <TCEforms>
                        <displayCond>FIELD:switchableControllerActions:=:Content->slider</displayCond>
                        <label>Mostrar puntos (indicadores)</label>
                        <config>
                            <type>check</type>
                            <default>0</default>
                        </config>
                    </TCEforms>
                </settings.slider.dots>

                <settings.slider.arrows>
                    <TCEforms>
                        <displayCond>FIELD:switchableControllerActions:=:Content->slider</displayCond>
                        <label>Mostrar flechas</label>
                        <config>
                            <type>check</type>
                            <default>1</default>
                        </config>
                    </TCEforms>
                </settings.slider.arrows>

                <settings.slider.slidesToShow>
						<TCEforms>
							<displayCond>FIELD:switchableControllerActions:=:Content->slider</displayCond>
							<label>Slides To Show</label>
							<config>
								<type>select</type>
								<renderType>selectSingle</renderType>
								<size>1</size>
								<default>3</default>
								<maxitems>1</maxitems>
								<items type="array">
									<numIndex index="0" type="array">
										<numIndex index="0">1</numIndex>
										<numIndex index="1">1</numIndex>
									</numIndex>
									<numIndex index="1" type="array">
										<numIndex index="0">2</numIndex>
										<numIndex index="1">2</numIndex>
									</numIndex>
									<numIndex index="2" type="array">
										<numIndex index="0">3</numIndex>
										<numIndex index="1">3</numIndex>
									</numIndex>
									<numIndex index="3" type="array">
										<numIndex index="0">4</numIndex>
										<numIndex index="1">4</numIndex>
									</numIndex>
									<numIndex index="4" type="array">
										<numIndex index="0">5</numIndex>
										<numIndex index="1">5</numIndex>
									</numIndex>
									<numIndex index="5" type="array">
										<numIndex index="0">6</numIndex>
										<numIndex index="1">6</numIndex>
									</numIndex>
								</items>
							</config>
						</TCEforms>
					</settings.slider.slidesToShow>

					<settings.slider.slidesToScroll>
						<TCEforms>
							<displayCond>FIELD:switchableControllerActions:=:Content->slider</displayCond>
							<label>Slides To Scroll</label>
							<config>
								<type>select</type>
								<renderType>selectSingle</renderType>
								<size>1</size>
								<default>3</default>
								<maxitems>1</maxitems>
								<items type="array">
									<numIndex index="0" type="array">
										<numIndex index="0">1</numIndex>
										<numIndex index="1">1</numIndex>
									</numIndex>
									<numIndex index="1" type="array">
										<numIndex index="0">2</numIndex>
										<numIndex index="1">2</numIndex>
									</numIndex>
									<numIndex index="2" type="array">
										<numIndex index="0">3</numIndex>
										<numIndex index="1">3</numIndex>
									</numIndex>
									<numIndex index="3" type="array">
										<numIndex index="0">4</numIndex>
										<numIndex index="1">4</numIndex>
									</numIndex>
									<numIndex index="4" type="array">
										<numIndex index="0">5</numIndex>
										<numIndex index="1">5</numIndex>
									</numIndex>
									<numIndex index="5" type="array">
										<numIndex index="0">6</numIndex>
										<numIndex index="1">6</numIndex>
									</numIndex>
								</items>
							</config>
						</TCEforms>
					</settings.slider.slidesToScroll>

            </el>
        </ROOT>
    </general>


   </sheets>
</T3DataStructure>