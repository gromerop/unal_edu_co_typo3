plugin.tx_powermail {


  view {
    # cat=powermail_main/file; type=string; label= Path to template root (FE)
    templateRootPaths {
        0 = EXT:unal_skin_unal/Resources/Private/ext/powermail/Templates/
    } 

    # cat=powermail_main/file; type=string; label= Path to template partials (FE)
    partialRootPaths  {
        0 = EXT:unal_skin_unal/Resources/Private/ext/powermail/Partials/
    }

    # cat=powermail_main/file; type=string; label= Path to template layouts (FE)
    layoutRootPaths {
        0 = EXT:unal_skin_unal/Resources/Private/ext/powermail/Layouts/
    } 
  }

}
