            instagram = https://www.instagram.com/unaloficial/?hl=es-la
			youtube = https://www.youtube.com/channel/UCnE6Zj2llVxcvL5I38B0Ceg
		}
		showCampusMenu = 0
		titleComplement =
		mainMenuUid = 5
		serviceMenuUid = 61
		sitemapLinkUid = 76
		faqLinkUid = 77
		contactLinkUid = 79
		glosaryLinkUid = 80
		aboutLinkUid = 81
      	onlineattLinkUid = 78
      	notinboxLinkUid = 65
		contact {
			address = Carrera 45 # 26-85
			building = Edif. Uriel Gutiérrez
			city = Bogotá D.C.,  Colombia
			phone = (+57 601) 316 5000
			emailAccount = conmutador_bog
		}
		aboutLinkUri = unal.edu.co/acerca-de-este-sitio-web.html
	}
}

