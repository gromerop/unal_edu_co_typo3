#
# BACKENDLAYOUT: DEFAULT
#
mod {
    web_layout {
        BackendLayouts {
            error {
                title = LLL:EXT:unal_skin_unal/Resources/Private/Language/locallang_be.xlf:backend_layout.error
                config {
                    backend_layout {
                        colCount = 2
                        rowCount = 1
                        rows {
                            1 {
                                columns {
                                    1 {
                                        name = LLL:EXT:unal_skin_unal/Resources/Private/Language/locallang_be.xlf:backend_layout.column.1
                                        colPos = 101
                                    }
                                    2 {
                                        name = LLL:EXT:unal_skin_unal/Resources/Private/Language/locallang_be.xlf:backend_layout.column.2
                                        colPos = 102
                                    }
                                }
                            }
                        }
                    }
                }
                icon = EXT:unal_skin_unal/Resources/Public/Images/BackendLayouts/default.png
            }
        }
    }
}
