
plugin.tx_unalnews_vistasrest {
    view {
        # cat=plugin.tx_unalnews_vistasrest/file; type=string; label=Path to template root (FE)
        templateRootPath = EXT:unal_news/Resources/Private/Templates/
        # cat=plugin.tx_unalnews_vistasrest/file; type=string; label=Path to template partials (FE)
        partialRootPath = EXT:unal_news/Resources/Private/Partials/
        # cat=plugin.tx_unalnews_vistasrest/file; type=string; label=Path to template layouts (FE)
        layoutRootPath = EXT:unal_news/Resources/Private/Layouts/
    }
    persistence {
        # cat=plugin.tx_unalnews_vistasrest//a; type=string; label=Default storage PID
        storagePid =
    }
}

