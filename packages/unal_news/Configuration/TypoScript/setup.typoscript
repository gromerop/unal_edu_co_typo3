# Module configuration
module.tx_unalnews_web_unalnewsunalnewsreporter {
    persistence {
        storagePid = {$module.tx_unalnews_unalnewsreporter.persistence.storagePid}
    }
    view {
        templateRootPaths.0 = EXT:{extension.extensionKey}/Resources/Private/Backend/Templates/
        templateRootPaths.1 = {$module.tx_unalnews_unalnewsreporter.view.templateRootPath}
        partialRootPaths.0 = EXT:unal_news/Resources/Private/Backend/Partials/
        partialRootPaths.1 = {$module.tx_unalnews_unalnewsreporter.view.partialRootPath}
        layoutRootPaths.0 = EXT:unal_news/Resources/Private/Backend/Layouts/
        layoutRootPaths.1 = {$module.tx_unalnews_unalnewsreporter.view.layoutRootPath}
    }
}

