
plugin.{extension.shortExtensionKey}_{plugin.key} {
    view {
        templateRootPaths.0 = EXT:{extension.shortExtensionKey}/Resources/Private/Templates/
        templateRootPaths.1 = {$plugin.tx_unalnews_vistasrest.view.templateRootPath}
        partialRootPaths.0 = EXT:unal_news/Resources/Private/Partials/
        partialRootPaths.1 = {$plugin.tx_unalnews_vistasrest.view.partialRootPath}
        layoutRootPaths.0 = EXT:tx_unalnews/Resources/Private/Layouts/
        layoutRootPaths.1 = {$plugin.tx_unalnews_vistasrest.view.layoutRootPath}
    }
    persistence {
        storagePid = {$plugin.tx_unalnews_vistasrest.persistence.storagePid}
        #recursive = 1
    }
    features {
        #skipDefaultArguments = 1
        # if set to 1, the enable fields are ignored in BE context
        ignoreAllEnableFieldsInBe = 0
        # Should be on by default, but can be disabled if all action in the plugin are uncached
        requireCHashArgumentForActionArguments = 1
    }
    mvc {
        #callDefaultActionIfActionCantBeResolved = 1
    }
}

plugin.{extension.shortExtensionKey}_{plugin.key} {
    view {
        templateRootPaths.0 = EXT:{extension.shortExtensionKey}/Resources/Private/Templates/
        templateRootPaths.1 = {$plugin.tx_unalnews_visitorcounter.view.templateRootPath}
        partialRootPaths.0 = EXT:unal_news/Resources/Private/Partials/
        partialRootPaths.1 = {$plugin.tx_unalnews_visitorcounter.view.partialRootPath}
        layoutRootPaths.0 = EXT:tx_unalnews/Resources/Private/Layouts/
        layoutRootPaths.1 = {$plugin.tx_unalnews_visitorcounter.view.layoutRootPath}
    }
    persistence {
        storagePid = {$plugin.tx_unalnews_visitorcounter.persistence.storagePid}
        #recursive = 1
    }
    features {
        #skipDefaultArguments = 1
        # if set to 1, the enable fields are ignored in BE context
        ignoreAllEnableFieldsInBe = 0
        # Should be on by default, but can be disabled if all action in the plugin are uncached
        requireCHashArgumentForActionArguments = 1
    }
    mvc {
        #callDefaultActionIfActionCantBeResolved = 1
    }
}

# these classes are only used in auto-generated templates
plugin.tx_unalnews._CSS_DEFAULT_STYLE (
    textarea.f3-form-error {
        background-color:#FF9F9F;
        border: 1px #FF0000 solid;
    }

    input.f3-form-error {
        background-color:#FF9F9F;
        border: 1px #FF0000 solid;
    }

    .tx-unal-news table {
        border-collapse:separate;
        border-spacing:10px;
    }

    .tx-unal-news table th {
        font-weight:bold;
    }

    .tx-unal-news table td {
        vertical-align:top;
    }

    .typo3-messages .message-error {
        color:red;
    }

    .typo3-messages .message-ok {
        color:green;
    }
)

# Module configuration
module.tx_unalnews_web_unalnewsunalnewsreporter {
    persistence {
        storagePid = {$module.tx_unalnews_unalnewsreporter.persistence.storagePid}
    }
    view {
        templateRootPaths.0 = EXT:{extension.extensionKey}/Resources/Private/Backend/Templates/
        templateRootPaths.1 = {$module.tx_unalnews_unalnewsreporter.view.templateRootPath}
        partialRootPaths.0 = EXT:unal_news/Resources/Private/Backend/Partials/
        partialRootPaths.1 = {$module.tx_unalnews_unalnewsreporter.view.partialRootPath}
        layoutRootPaths.0 = EXT:unal_news/Resources/Private/Backend/Layouts/
        layoutRootPaths.1 = {$module.tx_unalnews_unalnewsreporter.view.layoutRootPath}
    }
}

