plugin.tx_rest.settings.paths {
    1 {
        path = unal-unal_news-unalNews
        read = allow
        write = allow
        handlerClass = \UNAL\UnalNews\Rest\NewsHandler
    }
    2 {
        path = unal-unal_news-visitCounter
        read = deny
        write = allow
        handlerClass = \UNAL\UnalNews\Rest\VisitorHandler

    }
}

plugin.tx_rest.settings.aliases {
    noticias = unal-unal_news-unalNews
    visitas = unal-unal_news-visitCounter
}

plugin.tx_rest.settings {
    cors.allowedOrigins {
        0 = *
    }
    responseHeaders {
         Access-Control-Allow-Origin = *
         Access-Control-Allow-Methods = GET, POST
         # Inform the client that credentials may be used
        Access-Control-Allow-Credentials = true
        # Allow the client to send a `Content-Type` header for POST requests 
        Access-Control-Allow-Headers = Content-Type
     }
}
